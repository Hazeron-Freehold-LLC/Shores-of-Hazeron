TARGET = AuServerMon
VERSION = 7.0
TEMPLATE = app
RC_FILE = $$TARGET.rc
CONFIG += qt thread
QT += network opengl sql
INCLUDEPATH = ../auutil ../auatom ../audata ../auglobal ../auloginclient ../auloginserver ../aumail ../augl ../aumath ../ausceneserver /usr/local/inc ../auclientmailres
macx:CONFIG += c++11
!macx:QMAKE_CXXFLAGS += -std=c++11
 
CONFIG(debug, debug|release) {
	message($$TARGET Debug build configuration.)
	unix:TARGET = $$member(TARGET, 0)_debug
	win32:TARGET = $$member(TARGET, 0)D
	LIBS += -L../debug -lAuAtom_debug -lAuData_debug -lAuGlobal_debug -lAuUtil_debug -lGLU -lAuGL_debug -lAuMath_debug -lAuClientMailRes_debug -lAuStoryRes_debug
}
 
CONFIG(release, debug|release) {
	message($$TARGET Release build configuration.)
	LIBS += -L../release -lAuAtom -lAuData -lAuGlobal -lAuUtil -lGLU -lAuGL -lAuMath -lAuClientMailRes -lAuStoryRes
}

LIBS += -lopenal -lSDL2
