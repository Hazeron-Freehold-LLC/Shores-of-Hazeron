TARGET = AuAtom
VERSION = 7.0
TEMPLATE = lib
CONFIG += staticlib qt thread
QT += network sql opengl
DEFINES += AUATOM
macx:CONFIG += c++11
!macx:QMAKE_CXXFLAGS += -std=c++11
INCLUDEPATH = ../auutil ../audata ../auglobal ../augl ../aumath /usr/local/inc ../austoryres
macx:INCLUDEPATH += /usr/local/include

CONFIG(debug, debug|release) {
	message($$TARGET Debug build configuration.)
	DESTDIR = ../debug
	unix:TARGET = $$member(TARGET, 0)_debug
	win32:TARGET = $$member(TARGET, 0)D
	macx:INCLUDEPATH += /opt/local/include
	macx:LIBS += -L../debug -lAuGlobal_debug -lAuData_debug -lAuUtil_debug -lAuMath_debug -lAuGL_debug -lAuStoryRes_debug
}

CONFIG(release, debug|release) {
	message($$TARGET Release build configuration.)
	DESTDIR = ../release
	macx:INCLUDEPATH += /opt/local/include
	macx:LIBS += -L../release -lAuGlobal -lAuData -lAuUtil -lAuMath -lAuGL -lAuStoryRes
}

macx:LIBS += -L/usr/local/lib -lSDL2 -lm -liconv -Wl,-framework,OpenGL -Wl,-framework,ForceFeedback -lobjc -Wl,-framework,Cocoa -Wl,-framework,Carbon -Wl,-framework,IOKit -Wl,-framework,CoreAudio -Wl,-framework,AudioToolbox -Wl,-framework,AudioUnit -Wl,-framework,OpenAL
