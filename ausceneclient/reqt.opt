TARGET = AuSceneClient
VERSION = 7.0
TEMPLATE = app
RC_FILE = $$TARGET.rc
CONFIG += qt thread
QT += network opengl sql
macx:CONFIG += c++11
!macx:QMAKE_CXXFLAGS += -std=c++11
INCLUDEPATH = ../auclientres ../auutil ../audesigner ../auclient ../auatom  ../auatomres ../audata ../auglobal ../auloginclient ../aumail ../ausceneserver ../augl ../aumath ../aumodelres ../aubodypartsres ../autexture /usr/local/inc ../auclientmailres

macx:INCLUDEPATH += /opt/local/include
macx:INCLUDEPATH += /usr/local/include
macx:LIBS += -L/usr/local/lib
macx:LIBS += -framework OpenAL
 
CONFIG(debug, debug|release) {
	message($$TARGET Debug build configuration.)
	unix:TARGET = $$member(TARGET, 0)_debug
	win32:TARGET = $$member(TARGET, 0)D
	LIBS += -L../debug -lAuClientRes_debug -lAuDesigner_debug -lAuClient_debug -lAuAtom_debug -lAuData_debug -lAuLoginClient_debug -lAuMail_debug -lAuGlobal_debug -lAuUtil_debug -lAuMath_debug -lAuGL_debug -lAuAtomRes_debug -lAuModelRes_debug -lAuBodyPartsRes_debug -lAuTexture_debug -lAuClientMailRes_debug -lAuStoryRes_debug
}
 
CONFIG(release, debug|release) {
	message($$TARGET Release build configuration.)
	LIBS += -L../release -lAuClientRes -lAuDesigner -lAuClient -lAuAtom -lAuData -lAuLoginClient -lAuMail -lAuGlobal -lAuUtil -lAuMath -lAuGL -lAuAtomRes -lAuModelRes -lAuBodyPartsRes -lAuTexture -lAuClientMailRes -lAuStoryRes
}

LIBS += -lSDL2
!macx:LIBS += -lGLU -lopenal
