TARGET = AuServerStatus
VERSION = 7.0
TEMPLATE = app
CONFIG += qt console
QT += network
INCLUDEPATH = ../auutil ../ausceneserver ../auatom ../auloginserver ../aumailserver ../auloginserver
 
CONFIG(debug, debug|release) {
	message($$TARGET Debug build configuration.)
	unix:TARGET = $$member(TARGET, 0)_debug
	win32:TARGET = $$member(TARGET, 0)D
	LIBS += -L../debug -lAuUtil_debug
}
 
CONFIG(release, debug|release) {
	message($$TARGET Release build configuration.)
	LIBS += -L../release -lAuUtil
}
