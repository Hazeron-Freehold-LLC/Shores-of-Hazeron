TARGET = AuEmpireReport
VERSION = 7.0
TEMPLATE = app
RC_FILE = $$TARGET.rc
CONFIG += qt thread
QT += opengl network sql
INCLUDEPATH = ../auutil ../auatom ../audata ../auglobal ../auloginclient ../aumail ../augl ../aumath ../ausceneserver ../aubodypartsres ../auatomres /usr/local/inc
macx:LIBS += -L/opt/local/lib
macx:CONFIG += c++11
!macx:QMAKE_CXXFLAGS += -std=c++11
 
CONFIG(debug, debug|release) {
	message($$TARGET Debug build configuration.)
	TARGET = $$member(TARGET, 0)_debug
	LIBS += -L../debug -lAuAtom_debug -lAuData_debug -lAuGlobal_debug -lAuUtil_debug -lAuGL_debug -lAuMath_debug -lAuLoginClient_debug -lAuMail_debug -lAuBodyPartsRes_debug -lAuAtomRes_debug -lGLU -lAuStoryRes_debug
}
 
CONFIG(release, debug|release) {
	message($$TARGET Release build configuration.)
	LIBS += -L../release -lAuAtom -lAuData -lAuGlobal -lAuUtil -lAuGL -lAuMath -lAuLoginClient -lAuMail -lAuBodyPartsRes -lAuAtomRes -lGLU -lAuStoryRes
}

LIBS += -lopenal -lSDL2
