augl/.r/AuGLVer.h:
	@if [ "`uname -n | grep Capella`" != "" ] || [ "`uname -n | grep MacBook`" != "" ] ; then \
		if [ "`pwd | grep gl41`" != "" ] ; then \
			echo '#define AUGL41' > augl/.r/AuGLVer.h ; \
		else \
			echo '#define AUGL33' > augl/.r/AuGLVer.h ; \
		fi ; \
	else \
		echo '#define AUGL32' > augl/.r/AuGLVer.h ; \
	fi ;

release/libAuGL.a: augl/Makefile augl/.r/AuGLVer.h
	# Building augl
	$(MAKE) -C augl

