# Identify target names that are not to be confused with files or folders with the same name.
.PHONY: all client servers cgi relink report reqt clean auacctemail auacctexpire auacctnew auacctpassword auacctsendpassword auloginserver aumailclient aumailserver aulauncher auchatclient ausceneclient ausceneserver auscript auserverstatus auservermon

all: client servers cgi report

shipresume: relink client distrolauncher distropackage

shipit: reqt clean client distrolauncher distropackage

client: aumailclient aulauncher ausceneclient auchatclient

servers: ausceneserver auloginserver aumailserver

cgi: auacctemail auacctexpire auacctnew auacctpassword auacctsendpassword auserverstatus

report: auempirereport

story: auscript

distrolauncher: client
	@if [ "`uname -n | grep Capella`" != "" ] || [ "`uname -n | grep MacBook`" != "" ] ; then \
		if [ "`pwd | grep gl41`" != "" ] ; then \
			disttarget=macos10-gl41 ; \
		else \
			disttarget=macos10 ; \
		fi ; \
		echo 'Creating Apple '$$disttarget' 64-bit Launcher Distribution' ; \
		distfile=ShoresOfHazeron64$$disttarget.dmg ; \
		distarch=soh-$$disttarget-64 ; \
		rm -rf Shores\ of\ Hazeron.app; \
		mkdir Shores\ of\ Hazeron.app; \
		cp -R aulauncher/AuLauncher.app/Contents Shores\ of\ Hazeron.app; \
		mv Shores\ of\ Hazeron.app/Contents/MacOS/AuLauncher Shores\ of\ Hazeron.app/Contents/MacOS/Shores\ of\ Hazeron; \
		chmod ugo+x Shores\ of\ Hazeron.app/Contents/MacOS/Shores\ of\ Hazeron ; \
		cp aulauncher/Info.plist Shores\ of\ Hazeron.app/Contents; \
		cp aulauncher/PkgInfo Shores\ of\ Hazeron.app/Contents; \
		cp ausceneclient/data/SceneClient.png Shores\ of\ Hazeron.app/Contents/Resources/ShoresOfHazeron.png ; \
		cp ausceneclient/SoH.icns Shores\ of\ Hazeron.app/Contents/Resources ; \
		echo $$distarch > Shores\ of\ Hazeron.app/Contents/Resources/data.bin ; \
		macdeployqt Shores\ of\ Hazeron.app -dmg -appstore-compliant ; \
		rm -rf "$$distfile" ; \
		mv Shores\ of\ Hazeron.dmg "$$distfile"; \
	else \
		if [ "`uname -n | grep Manjaro21`" != "" ] ; then \
			echo 'Creating Manjaro Linux 21 64-bit Launcher Distribution' ; \
			distfile=ShoresOfHazeron64manjaro21.tar.gz ; \
			distarch=soh-manjaro21-64 ; \
			targroup=nobody ; \
		elif [ "`uname -n | grep Fedora35`" != "" ] ; then \
			echo 'Creating Fedora Linux 21 64-bit Launcher Distribution' ; \
			distfile=ShoresOfHazeron64fedora35.tar.gz ; \
			distarch=soh-fedora35-64 ; \
			targroup=nobody ; \
		elif [ "`uname -n | grep Ubuntu20`" != "" ] ; then \
			echo 'Creating Ubuntu Linux 20 64-bit Launcher Distribution' ; \
			distfile=ShoresOfHazeron64ubuntu20.tar.gz ; \
			distarch=soh-ubuntu20-64 ; \
			targroup=nogroup ; \
		elif [ "`uname -n | grep Debian11`" != "" ] ; then \
			echo 'Creating Debian Linux 11 64-bit Launcher Distribution' ; \
			distfile=ShoresOfHazeron64debian11.tar.gz ; \
			distarch=soh-debian11-64 ; \
			targroup=nogroup ; \
		fi ; \
		if [ "$$distfile" != "" ] ; then \
			rm -rf Shores\ of\ Hazeron ; \
			mkdir Shores\ of\ Hazeron ; \
			mkdir Shores\ of\ Hazeron/Launcher ; \
			chmod ugo+x aulauncher/AuLauncher ; \
			cp aulauncher/AuLauncher Shores\ of\ Hazeron/Launcher/HazeronLauncher ; \
			cp ausceneclient/data/SceneClient.png Shores\ of\ Hazeron/Launcher/HazeronLauncher.png ; \
			echo $$distarch > Shores\ of\ Hazeron/Launcher/data.bin ; \
			rm -rf "$$distfile" ; \
			tar cfz "$$distfile" Shores\ of\ Hazeron/Launcher --owner nobody --group "$$targroup" ; \
		fi ; \
	fi ; \
	if [ "$$distfile" != "" ] ; then \
		echo Posting $$distfile to Hazeron/Downloads ; \
		cp -f "$$distfile" /sei/Common/Hazeron/Downloads ; \
		echo Done ; \
	else \
		echo error: distrolauncher unrecognized builder: `uname -n` ; \
	fi ;

distropackage: ausceneclient aumailclient auchatclient
	@if [ "`uname -n | grep Capella`" != "" ] ; then \
		if [ "`pwd | grep gl41`" != "" ] ; then \
			disttarget=macos10-gl41 ; \
		else \
			disttarget=macos10 ; \
		fi ; \
		echo 'Creating Apple '$$disttarget' 64-bit Package Distribution' ; \
		distfile=soh-$$disttarget-64.tgz ; \
		distarch=soh-$$disttarget-64 ; \
		targroup=nogroup ; \
		rm -rf $$distarch ; \
		mkdir $$distarch ; \
		mkdir $$distarch/SoH.app ; \
		mkdir $$distarch/SoH.app/Contents ; \
		mkdir $$distarch/SoH.app/Contents/Resources ; \
		\
		echo 'Constructing SoH.app' ; \
		cp -R ausceneclient/AuSceneClient.app/Contents $$distarch/SoH.app ; \
		mv $$distarch/SoH.app/Contents/MacOS/AuSceneClient $$distarch/SoH.app/Contents/MacOS/SoH ; \
		cp ausceneclient/Info.plist $$distarch/SoH.app/Contents ; \
		cp ausceneclient/PkgInfo $$distarch/SoH.app/Contents ; \
		cp ausceneclient/data/SceneClient.png $$distarch/SoH.app/Contents/Resources/ShoresOfHazeron.png ; \
		cp ausceneclient/SoH.icns $$distarch/SoH.app/Contents/Resources ; \
		mkdir $$distarch/SoH.app/Contents/Frameworks ; \
		cp release/libAuAtomRes.7.0.0.dylib $$distarch/SoH.app/Contents/Frameworks/libAuAtomRes.7.dylib ; \
		install_name_tool -id @executable_path/../Frameworks/libAuAtomRes.7.dylib $$distarch/SoH.app/Contents/Frameworks/libAuAtomRes.7.dylib ; \
		cp release/libAuBodyPartsRes.7.0.0.dylib $$distarch/SoH.app/Contents/Frameworks/libAuBodyPartsRes.7.dylib ; \
		install_name_tool -id @executable_path/../Frameworks/libAuBodyPartsRes.7.dylib $$distarch/SoH.app/Contents/Frameworks/libAuBodyPartsRes.7.dylib ; \
		cp release/libAuClientRes.7.0.0.dylib $$distarch/SoH.app/Contents/Frameworks/libAuClientRes.7.dylib ; \
		install_name_tool -id @executable_path/../Frameworks/libAuClientRes.7.dylib $$distarch/SoH.app/Contents/Frameworks/libAuClientRes.7.dylib ; \
		cp release/libAuClientMailRes.7.0.0.dylib $$distarch/SoH.app/Contents/Frameworks/libAuClientMailRes.7.dylib ; \
		install_name_tool -id @executable_path/../Frameworks/libAuClientMailRes.7.dylib $$distarch/SoH.app/Contents/Frameworks/libAuClientMailRes.7.dylib ; \
		cp release/libAuModelRes.7.0.0.dylib $$distarch/SoH.app/Contents/Frameworks/libAuModelRes.7.dylib ; \
		install_name_tool -id @executable_path/../Frameworks/libAuModelRes.7.dylib $$distarch/SoH.app/Contents/Frameworks/libAuModelRes.7.dylib ; \
		cp release/libAuTexture.7.0.0.dylib $$distarch/SoH.app/Contents/Frameworks/libAuTexture.7.dylib ; \
		install_name_tool -id @executable_path/../Frameworks/libAuTexture.7.dylib $$distarch/SoH.app/Contents/Frameworks/libAuTexture.7.dylib ; \
		cp GD $$distarch/SoH.app/Contents/Resources ; \
		mkdir $$distarch/SoH.app/Contents/MacOS/tex ; \
		cp autexture/data/*.png $$distarch/SoH.app/Contents/MacOS/tex ; \
		cp auglobal/sfx/sfx.har $$distarch/SoH.app/Contents/MacOS ; \
		mkdir $$distarch/SoH.app/Contents/Resources/Blueprints ; \
		mkdir $$distarch/SoH.app/Contents/Resources/Blueprints/Buildings ; \
		mkdir $$distarch/SoH.app/Contents/Resources/Blueprints/Spacecraft ; \
		cp Blueprints/Buildings/*.SoH $$distarch/SoH.app/Contents/Resources/Blueprints/Buildings ; \
		cp Blueprints/Spacecraft/*.SoH $$distarch/SoH.app/Contents/Resources/Blueprints/Spacecraft ; \
		macdeployqt $$distarch/SoH.app -appstore-compliant ; \
		install_name_tool -change libAuAtomRes.7.dylib @executable_path/../Frameworks/libAuAtomRes.7.dylib $$distarch/SoH.app/Contents/MacOS/SoH ; \
		install_name_tool -change libAuModelRes.7.dylib @executable_path/../Frameworks/libAuModelRes.7.dylib $$distarch/SoH.app/Contents/MacOS/SoH ; \
		install_name_tool -change libAuBodyPartsRes.7.dylib @executable_path/../Frameworks/libAuBodyPartsRes.7.dylib $$distarch/SoH.app/Contents/MacOS/SoH ; \
		install_name_tool -change libAuClientRes.7.dylib @executable_path/../Frameworks/libAuClientRes.7.dylib $$distarch/SoH.app/Contents/MacOS/SoH ; \
		install_name_tool -change libAuClientMailRes.7.dylib @executable_path/../Frameworks/libAuClientMailRes.7.dylib $$distarch/SoH.app/Contents/MacOS/SoH ; \
		install_name_tool -change libAuTexture.7.dylib @executable_path/../Frameworks/libAuTexture.7.dylib $$distarch/SoH.app/Contents/MacOS/SoH ; \
		\
		echo 'Constructing SoHCommander.app' ; \
		mkdir $$distarch/SoHCommander.app ; \
		cp -R auchatclient/AuChatClient.app/Contents $$distarch/SoHCommander.app ; \
		mv $$distarch/SoHCommander.app/Contents/MacOS/AuChatClient $$distarch/SoHCommander.app/Contents/MacOS/SoHCommander ; \
		cp auchatclient/Info.plist $$distarch/SoHCommander.app/Contents ; \
		cp auchatclient/PkgInfo $$distarch/SoHCommander.app/Contents ; \
		cp auchatclient/data/ChatClient.png $$distarch/SoHCommander.app/Contents/Resources/SoHCommander.png ; \
		cp auchatclient/SoH.icns $$distarch/SoHCommander.app/Contents/Resources/SoHCommander.icns ; \
		mkdir $$distarch/SoHCommander.app/Contents/Frameworks ; \
		cp release/libAuAtomRes.7.0.0.dylib $$distarch/SoHCommander.app/Contents/Frameworks/libAuAtomRes.7.dylib ; \
		install_name_tool -id @executable_path/../Frameworks/libAuAtomRes.7.dylib $$distarch/SoHCommander.app/Contents/Frameworks/libAuAtomRes.7.dylib ; \
		cp release/libAuBodyPartsRes.7.0.0.dylib $$distarch/SoHCommander.app/Contents/Frameworks/libAuBodyPartsRes.7.dylib ; \
		install_name_tool -id @executable_path/../Frameworks/libAuBodyPartsRes.7.dylib $$distarch/SoHCommander.app/Contents/Frameworks/libAuBodyPartsRes.7.dylib ; \
		cp release/libAuClientRes.7.0.0.dylib $$distarch/SoHCommander.app/Contents/Frameworks/libAuClientRes.7.dylib ; \
		install_name_tool -id @executable_path/../Frameworks/libAuClientRes.7.dylib $$distarch/SoHCommander.app/Contents/Frameworks/libAuClientRes.7.dylib ; \
		cp release/libAuClientMailRes.7.0.0.dylib $$distarch/SoHCommander.app/Contents/Frameworks/libAuClientMailRes.7.dylib ; \
		install_name_tool -id @executable_path/../Frameworks/libAuClientMailRes.7.dylib $$distarch/SoHCommander.app/Contents/Frameworks/libAuClientMailRes.7.dylib ; \
		cp release/libAuModelRes.7.0.0.dylib $$distarch/SoHCommander.app/Contents/Frameworks/libAuModelRes.7.dylib ; \
		install_name_tool -id @executable_path/../Frameworks/libAuModelRes.7.dylib $$distarch/SoHCommander.app/Contents/Frameworks/libAuModelRes.7.dylib ; \
		cp GD $$distarch/SoHCommander.app/Contents/Resources ; \
		mkdir $$distarch/SoHCommander.app/Contents/MacOS/sfx ; \
		macdeployqt $$distarch/SoHCommander.app -appstore-compliant ; \
		install_name_tool -change libAuAtomRes.7.dylib @executable_path/../Frameworks/libAuAtomRes.7.dylib $$distarch/SoHCommander.app/Contents/MacOS/SoHCommander ; \
		install_name_tool -change libAuModelRes.7.dylib @executable_path/../Frameworks/libAuModelRes.7.dylib $$distarch/SoHCommander.app/Contents/MacOS/SoHCommander ; \
		install_name_tool -change libAuBodyPartsRes.7.dylib @executable_path/../Frameworks/libAuBodyPartsRes.7.dylib $$distarch/SoHCommander.app/Contents/MacOS/SoHCommander ; \
		install_name_tool -change libAuClientRes.7.dylib @executable_path/../Frameworks/libAuClientRes.7.dylib $$distarch/SoHCommander.app/Contents/MacOS/SoHCommander ; \
		install_name_tool -change libAuClientMailRes.7.dylib @executable_path/../Frameworks/libAuClientMailRes.7.dylib $$distarch/SoHCommander.app/Contents/MacOS/SoHCommander ; \
		\
		echo 'Constructing SoHMail.app' ; \
		mkdir $$distarch/SoHMail.app ; \
		cp -R aumailclient/AuMailClient.app/Contents $$distarch/SoHMail.app ; \
		mv $$distarch/SoHMail.app/Contents/MacOS/AuMailClient $$distarch/SoHMail.app/Contents/MacOS/SoHMail ; \
		cp aumailclient/Info.plist $$distarch/SoHMail.app/Contents ; \
		cp aumailclient/PkgInfo $$distarch/SoHMail.app/Contents ; \
		cp aumailclient/data/Mail.png $$distarch/SoHMail.app/Contents/Resources/SoHMail.png ; \
		cp aumailclient/SoHMail.icns $$distarch/SoHMail.app/Contents/Resources ; \
		mkdir $$distarch/SoHMail.app/Contents/Frameworks ; \
		cp release/libAuClientMailRes.7.0.0.dylib $$distarch/SoHMail.app/Contents/Frameworks/libAuClientMailRes.7.dylib ; \
		install_name_tool -id @executable_path/../Frameworks/libAuClientMailRes.7.dylib $$distarch/SoHMail.app/Contents/Frameworks/libAuClientMailRes.7.dylib ; \
		macdeployqt $$distarch/SoHMail.app -appstore-compliant ; \
		install_name_tool -change libAuClientMailRes.7.dylib @executable_path/../Frameworks/libAuClientMailRes.7.dylib $$distarch/SoHMail.app/Contents/MacOS/SoHMail ; \
		\
		echo 'Creating MD5 Sums' ; \
		cd $$distarch ; \
		find . -type f -exec md5 -r {} \; > md5sums ; \
		chmod -R ugo+r . ; \
		chmod ugo+x SoH.app/Contents/MacOS/SoH ; \
		chmod ugo+x SoHMail.app/Contents/MacOS/SoHMail ; \
		cd .. ; \
	else \
		if [ "`uname -n | grep Manjaro21`" != "" ] ; then \
			echo 'Creating Manjaro Linux 21 64-bit Package Distribution' ; \
			distfile=soh-manjaro21-64.tgz ; \
			distarch=soh-manjaro21-64 ; \
			targroup=nobody ; \
		elif [ "`uname -n | grep Fedora35`" != "" ] ; then \
			echo 'Creating Fedora Linux 21 64-bit Package Distribution' ; \
			distfile=soh-fedora35-64.tgz ; \
			distarch=soh-fedora35-64 ; \
			targroup=nobody ; \
		elif [ "`uname -n | grep Ubuntu20`" != "" ] ; then \
			echo 'Creating Ubuntu Linux 20 64-bit Package Distribution' ; \
			distfile=soh-ubuntu20-64.tgz ; \
			distarch=soh-ubuntu20-64 ; \
			targroup=nogroup ; \
		elif [ "`uname -n | grep Debian11`" != "" ] ; then \
			echo 'Creating Debian Linux 11 64-bit Package Distribution' ; \
			distfile=soh-debian11-64.tgz ; \
			distarch=soh-debian11-64 ; \
			targroup=nogroup ; \
		fi ; \
		if [ "$$distfile" != "" ] ; then \
			rm -rf $$distarch ; \
			mkdir $$distarch ; \
			mkdir $$distarch/tex ; \
			mkdir $$distarch/Blueprints ; \
			mkdir $$distarch/Blueprints/Buildings ; \
			mkdir $$distarch/Blueprints/Spacecraft ; \
			\
			cp GD $$distarch ; \
			cp autexture/data/*.png $$distarch/tex ; \
			cp auglobal/sfx/sfx.har $$distarch ; \
			cp Blueprints/Buildings/*.SoH $$distarch/Blueprints/Buildings ; \
			cp Blueprints/Spacecraft/*.SoH $$distarch/Blueprints/Spacecraft ; \
			\
			cp aumailclient/AuMailClient $$distarch ; \
			strip $$distarch/AuMailClient ; \
			cp aumailclient/HazeronMail $$distarch ; \
			cp aumailclient/data/Mail.png $$distarch/HazeronMail.png ; \
			\
			cp ausceneclient/AuSceneClient $$distarch ; \
			strip $$distarch/AuSceneClient ; \
			cp ausceneclient/ShoresOfHazeron $$distarch ; \
			cp ausceneclient/data/SceneClient.png $$distarch/ShoresOfHazeron.png ; \
			\
			cp auchatclient/AuChatClient $$distarch ; \
			strip $$distarch/AuChatClient ; \
			cp auchatclient/HazeronCommander $$distarch ; \
			cp auchatclient/data/ChatClient.png $$distarch/HazeronCommander.png ; \
			\
			cp release/*.so.7 $$distarch ; \
			strip release/*.so.7 ; \
			\
			cd $$distarch ; \
			find . -type f -exec md5sum {} \; > md5sums ; \
			chmod -R ugo+r . ; \
			chmod ugo+x ShoresOfHazeron AuSceneClient ; \
			chmod ugo+x HazeronCommander AuChatClient ; \
			chmod ugo+x HazeronMail AuMailClient ; \
			cd .. ; \
		fi ; \
	fi ; \
	if [ "$$distfile" != "" ] ; then \
		echo Creating $$distfile ; \
		rm -rf "$$distfile" ; \
		tar cfz "$$distfile" $$distarch ; \
		echo Posting $$distfile to Hazeron/Downloads ; \
		cp -f "$$distfile" /sei/Common/Hazeron/Downloads ; \
		echo Done ; \
	else \
		echo error: distropackage unrecognized builder: `uname -n` ; \
	fi ;

relink:
	# Removing libraries and executables so they have to be archived or linked over again.
	rm -f auacctemail/AuAcctEmail*
	rm -f auacctexpire/AuAcctExpire*
	rm -f auacctnew/AuAcctNew*
	rm -f auacctpassword/AuAcctPassword*
	rm -f auacctsendpassword/AuAcctSendPassword*
	rm -f auempirereport/AuEmpireReport
	rm -f auloginserver/AuLoginServer
	rm -f aumailclient/AuMailClient
	rm -f aumailserver/AuMailServer
	rm -f auservermon/AuServerMon
	rm -f aulauncher/AuLauncher
	rm -f ausceneclient/AuSceneClient
	rm -f auchatclient/AuChatClient
	rm -f ausceneserver/AuSceneServer
	rm -f auscript/AuScript
	rm -f auserverstatus/AuServerStatus
	rm -f release/libAuAtom*
	rm -f release/libAuAtomRes*
	rm -f release/libAuBodyParts*
	rm -f release/libAuClient*
	rm -f release/libAuData*
	rm -f release/libAuDesigner*
	rm -f release/libAuGL*
	rm -f release/libAuGlobal*
	rm -f release/libAuLoginClient*
	rm -f release/libAuMail*
	rm -f release/libAuMath*
	rm -f release/libAuModel*
	rm -f release/libAuPowerArmor*
	rm -f release/libAuShipTex0*
	rm -f release/libAuScTex1*
	rm -f release/libAuScTex2*
	rm -f release/libAuScTex3*
	rm -f release/libAuScTex4*
	rm -f release/libAuScTex5*
	rm -f release/libAuStoryRes*
	rm -f release/libAuTexture*
	rm -f release/libAuUtil*

