TARGET = AuMailClient
VERSION = 7.0
TEMPLATE = app
CONFIG += qt thread
QT += opengl network sql
INCLUDEPATH = ../auutil ../audata ../auglobal ../auloginclient ../aumail ../aumath ../augl /usr/local/inc ../auclientmailres
macx:INCLUDEPATH += /usr/local/include
macx:LIBS += -framework OpenAL
RC_FILE = $$TARGET.rc
macx:LIBS += -L/opt/local/lib
macx:CONFIG += c++11
!macx:QMAKE_CXXFLAGS += -std=c++11
 
CONFIG(debug, debug|release) {
	message($$TARGET Debug build configuration.)
	TARGET = $$member(TARGET, 0)_debug
	LIBS += -L../debug -lAuClientMailRes_debug -lAuData_debug -lAuGlobal_debug -lAuUtil_debug -lAuGL_debug -lAuMath_debug -lAuLoginClient_debug -lAuMail_debug
}
 
CONFIG(release, debug|release) {
	message($$TARGET Release build configuration.)
	LIBS += -L../release -lAuClientMailRes -lAuData -lAuGlobal -lAuUtil -lAuGL -lAuMath -lAuLoginClient -lAuMail
}

!macx:LIBS += -lGLU -lopenal
