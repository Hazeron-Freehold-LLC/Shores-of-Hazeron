TARGET = AuMail
VERSION = 7.0
TEMPLATE = lib
CONFIG += staticlib qt thread
QT += opengl network sql
DEFINES += AUMAIL
INCLUDEPATH = ../auutil ../audata ../auglobal ../aumailserver ../aumath ../auloginclient ../augl /usr/local/inc
macx:INCLUDEPATH += /usr/local/include
macx:LIBS += -framework OpenAL
macx:CONFIG += c++11
!macx:QMAKE_CXXFLAGS += -std=c++11

CONFIG(debug, debug|release) {
	message($$TARGET Debug build configuration.)
	DESTDIR = ../debug
	TARGET = $$member(TARGET, 0)_debug
	macx:LIBS += -L../debug -lAuGlobal_debug -lAuUtil_debug -lAuMath_debug -lAuGL_debug -lAuLoginClient_debug
}

CONFIG(release, debug|release) {
	message($$TARGET Release build configuration.)
	DESTDIR = ../release
	macx:LIBS += -L../release -lAuGlobal -lAuUtil -lAuMath -lAuGL -lAuLoginClient
}
