TARGET = AuGlobal
VERSION = 7.0
TEMPLATE = lib
CONFIG += staticlib qt thread
QT += opengl network sql widgets
DEFINES += AUGLOBAL
INCLUDEPATH = ../auutil ../auloginserver ../aumailserver ../aumath ../augl
macx:INCLUDEPATH += /usr/local/include
macx:CONFIG += c++11
macx:LIBS += -framework OpenAL
!macx:QMAKE_CXXFLAGS += -std=c++11

CONFIG(debug, debug|release) {
	message($$TARGET Debug build configuration.)
	DESTDIR = ../debug
	TARGET = $$member(TARGET, 0)_debug
	macx:LIBS += -L../debug -lAuUtil_debug -lAuMath_debug -lAuGL_debug
}

CONFIG(release, debug|release) {
	message($$TARGET Release build configuration.)
	DESTDIR = ../release
	macx:LIBS += -L../release -lAuUtil -lAuMath -lAuGL
}

