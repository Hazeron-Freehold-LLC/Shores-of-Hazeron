TARGET = AuMailServer
VERSION = 7.0
TEMPLATE = app
CONFIG += qt thread
QT += opengl network sql
INCLUDEPATH = ../auutil ../audata ../auglobal ../aumath ../augl
macx:LIBS += -L/opt/local/lib
macx:CONFIG += c++11
!macx:QMAKE_CXXFLAGS += -std=c++11
 
CONFIG(debug, debug|release) {
	message($$TARGET Debug build configuration.)
	TARGET = $$member(TARGET, 0)_debug
	LIBS += -L../debug -lAuGlobal_debug -lAuUtil_debug -lAuGL_debug -lAuMath_debug -lGLU
}
 
CONFIG(release, debug|release) {
	message($$TARGET Release build configuration.)
	LIBS += -L../release -lAuGlobal -lAuUtil -lAuGL -lAuMath -lGLU
}

LIBS += -lopenal -lSDL2
