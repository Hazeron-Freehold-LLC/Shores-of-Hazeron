TARGET = AuTexture
VERSION = 7.0
TEMPLATE = lib
CONFIG += dll qt thread
DEFINES += AUTEXTURE

CONFIG(debug, debug|release) {
	message($$TARGET Debug build configuration.)
	DESTDIR = ../debug
	TARGET = $$member(TARGET, 0)_debug
	LIBS += -L../debug -lAuShipTex0_debug -lAuScTex1_debug -lAuScTex2_debug -lAuScTex3_debug -lAuScTex4_debug -lAuScTex5_debug
}

CONFIG(release, debug|release) {
	message($$TARGET Release build configuration.)
	DESTDIR = ../release
	LIBS += -L../release -lAuShipTex0 -lAuScTex1 -lAuScTex2 -lAuScTex3 -lAuScTex4 -lAuScTex5
}
